{% if page.educations and page.educations.size > 0 %}
  <div class="education">
    {% for edu in page.educations %}
      <article class="edu-entry">
        {% if edu.icon %}
          <div class="edu-logo">
            {% assign logo_path = edu.icon | prepend: '/assets/img/' %}
            {% include figure.liquid loading="lazy" path=logo_path alt=edu.institution %}
          </div>
        {% endif %}

        <div class="edu-info">
          <div class="edu-heading">
            <h3 class="edu-institution">{{ edu.institution }}</h3>
            <span class="edu-period">{{ edu.period }}</span>
          </div>

          {% if edu.degree %}
            <p class="edu-degree">{{ edu.degree }}</p>
          {% endif %}

          {% if edu.advisor %}
            <p class="edu-advisor">
              Advisor:
              {% if edu.advisor_url %}
                <a href="{{ edu.advisor_url }}">{{ edu.advisor }}</a>
              {% else %}
                {{ edu.advisor }}
              {% endif %}
            </p>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
{% endif %}
